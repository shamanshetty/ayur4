{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/book-appointment/[doctorId]",
      "regex": "^/book\\-appointment/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdoctorId": "nxtPdoctorId"
      },
      "namedRegex": "^/book\\-appointment/(?<nxtPdoctorId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/doctor/[id]",
      "regex": "^/doctor/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/doctor/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/calendar",
      "regex": "^/calendar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/calendar(?:/)?$"
    },
    {
      "page": "/community",
      "regex": "^/community(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/community(?:/)?$"
    },
    {
      "page": "/consultation",
      "regex": "^/consultation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consultation(?:/)?$"
    },
    {
      "page": "/dashboard/doctor",
      "regex": "^/dashboard/doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/doctor(?:/)?$"
    },
    {
      "page": "/dashboard/patient",
      "regex": "^/dashboard/patient(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/patient(?:/)?$"
    },
    {
      "page": "/discover",
      "regex": "^/discover(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/discover(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/find-doctors",
      "regex": "^/find\\-doctors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/find\\-doctors(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/login/doctor",
      "regex": "^/login/doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login/doctor(?:/)?$"
    },
    {
      "page": "/login/patient",
      "regex": "^/login/patient(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login/patient(?:/)?$"
    },
    {
      "page": "/my-appointments",
      "regex": "^/my\\-appointments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-appointments(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/signup/doctor",
      "regex": "^/signup/doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup/doctor(?:/)?$"
    },
    {
      "page": "/signup/patient",
      "regex": "^/signup/patient(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup/patient(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}